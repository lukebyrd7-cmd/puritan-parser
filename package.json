{
  "name": "puritan-parser",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "serve -s .",
    "data:download": "node scripts/download-source-data.js",
    "data:build": "node scripts/build-expanded-vocab.js",
    "data:refresh": "npm run data:download && npm run data:build",
    "test": "node --test",
    "gloss:audit": "node scripts/gloss-audit.js",
    "reader:generate": "node scripts/generate-reader-data.js",
    "hebrew:reader:generate": "node scripts/generate-hebrew-reader-data.js",
    "translation:oeb:generate": "node scripts/generate-oeb-translation-data.js",
    "translation:web:generate": "node scripts/generate-web-translation-data.js",
    "reader:audit": "node scripts/audit-reader-data.js",
    "reader:update": "npm run data:download && npm run reader:generate && npm run reader:audit && npm test"
  },
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
